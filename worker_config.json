{
  "server": {
    "url": "http://10.0.0.59:8080",
    "timeout": 30
  },
  
  "connection": {
    "max_registration_attempts": 3,
    "reconnection_interval_seconds": 180,
    "auto_reconnect": true
  },
  
  "worker": {
    "id": "auto_hostname",
    "max_concurrent_jobs": 1,
    "heartbeat_interval": 30,
    "metrics_interval": 60
  },
  
  "jobs": {
    "timeout_per_frame": 3600,
    "retry_attempts": 2
  },
  
  "performance": {
    "asset_cache_gb": 32,
    "use_ram_disk": true,
    "local_temp_size_gb": 64,
    "preload_common_assets": true,
    "max_render_threads": 16,
    "use_gpu": true
  },
  
  "gpu": {
    "force_enable": false,
    "name": "Quadro M4000",
    "memory_gb": 8,
    "cuda_version": "12.2"
  },
  
  "paths": {
    "log_directory": "logs",
    "local_cache": "C:\\render_cache"
  },
  
  "resources": {
    "max_memory_percent": 90,
    "max_cpu_percent": 95
  },
  
  "network": {
    "connection_pool_size": 10,
    "request_timeout": 30,
    "asset_download_threads": 4
  },

  "redis": {
    "enabled": false,
    "host": "10.0.0.59",
    "port": 6379,
    "connection_timeout": 5,
    "max_retry_attempts": 3,
    "comment": "Redis instant notifications (optional) - only enable if Redis is exposed on network. Workers work fine with HTTP polling when disabled."
  },

  "logging": {
    "level": "INFO",
    "file_path": "logs/worker.log"
  }
}