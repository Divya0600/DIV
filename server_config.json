{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "database_path": "render_farm.db"
  },
  
  "workers": {
    "auto_register": true,
    "heartbeat_interval": 30,
    "offline_timeout": 120
  },
  
  "jobs": {
    "max_concurrent_jobs": 1000,
    "default_batch_size": 10,
    "auto_cleanup_completed": true,
    "cleanup_after_days": 7
  },
  
  
  "logging": {
    "level": "INFO",
    "file_path": "logs/server.log"
  }
}